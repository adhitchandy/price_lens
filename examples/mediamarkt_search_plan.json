{
  "searches": [
    {
      "search_term": "Google Pixel smartphone",
      "product_type": "Smartphone",
      "include": ["pixel"],
      "exclude": ["case", "cover", "screen protector"]
    }
  ],
  "marketplaces": ["mediamarkt.de"],
  "headless": true,
  "pages": 1,
  "retries": 2,
  "delay_seconds": [2.5, 4.5],
  "enrich_details": true,
  "max_detail_products": 20,
  "output_dir": "output",
  "cleaning": {
    "remove_sponsored": true,
    "remove_no_price": true,
    "remove_duplicates": true,
    "remove_outliers": true,
    "outlier_pct": 99
  }
}
